# ─── Auth Server Environment Variables ─────────────────────────────────────────
# Copy this to .env and fill in your values

PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/synthcrypto

# JWT secret — use a long random string in production
JWT_SECRET=synthcrypto-jwt-secret-change-me-in-production

# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Frontend URL (React dev server)
CLIENT_URL=http://localhost:5173

# Simulator URL (Flask)
SIMULATOR_URL=http://localhost:5000
